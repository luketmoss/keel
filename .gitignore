# Keel workspace-level ignores.
# Project folders add their own .gitignore for stack-specific artifacts.

.DS_Store
Thumbs.db
*.log

__pycache__/
*.pyc

.env
.env.*
!.env.example

.claude/settings.local.json

# Vitest writes a cache here when run from the workspace root rather than
# inside a project folder.
node_modules/

scratchpad/
