# VITE_* values are inlined into the client bundle and readable by anyone who
# loads the app. They are configuration, not secrets.
#
# The scaffold reads none of these yet. They are the variables the spec's §8
# work will require, named here so the list grows by filling in rather than by
# remembering. Delete any that turn out not to be needed.

# OAuth client ID from Google Cloud Console -> APIs & Services -> Credentials.
VITE_GOOGLE_CLIENT_ID=

# The Journal's own Google Sheet — one row per Denver-local date (spec §6).
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_ID>/edit
VITE_SPREADSHEET_ID=

# Thrive's Apps Script API. Does not exist yet — sync plan Phase 2b (spec §8).
VITE_THRIVE_API_URL=

# Hive's Apps Script API, for getItems and the new getAuditLog (spec §8).
VITE_HIVE_API_URL=

# Deep-link bases (spec §5). Thrive: <base>#/history/:id and /edit.
# Hive: item deep-linking is new work — spec §8.
VITE_THRIVE_APP_URL=
VITE_HIVE_APP_URL=
