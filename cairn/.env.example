# Google Maps browser key, restricted to the Maps JavaScript API and to the
# origins this app is served from. Copy to .env.local and fill in.
#
# The key ships in the client bundle and is readable by anyone loading the app;
# referrer restriction and a quota cap are what protect it, not secrecy.
VITE_GOOGLE_MAPS_API_KEY=

# OAuth 2.0 browser client ID from the same Google Cloud project, used to sign
# in and request the drive.file scope. Create it under APIs & Services >
# Credentials > OAuth client ID > Web application, with this app's origin
# listed as an authorized JavaScript origin.
#
# Like the Maps key, this ships in the client bundle. A client ID is not a
# secret — it identifies the app to Google's consent screen, nothing else.
VITE_GOOGLE_CLIENT_ID=

# Map ID from the same Google Cloud project, required for Advanced Markers
# (#54's photo markers) — Google refuses to render an AdvancedMarker without
# one. Create it under Google Maps Platform > Map Management > Create Map ID
# (any map type; vector rendering isn't required for advanced markers).
#
# Not a secret, same as the two keys above. Left unset, the map still renders
# tracks exactly as before — photo markers just don't appear.
VITE_GOOGLE_MAPS_MAP_ID=

# Base path the app is served from, e.g. /keel/cairn/ on GitHub Pages. Read at
# build time in vite.config.ts (via process.env, not import.meta.env) — it sets
# Vite's `base`, which Vite then exposes to application code as
# import.meta.env.BASE_URL. Never read this var directly outside vite.config.ts.
#
# Unset in dev and in the cairn.yml check build, both of which default to '/'.
# The Pages deploy workflow sets it explicitly.
VITE_BASE_PATH=

# Set to 1 to run against #93's dev-only fake Drive instead of a real Google
# account: no popup, no real Drive, two seeded trips, a persistent banner
# marking the session as fake. Never has any effect in a production build,
# regardless of this value — `npm run dev` only. Leave unset for the real
# thing.
VITE_FAKE_DRIVE=
