# VITE_* values are inlined into the client bundle and readable by anyone who
# loads the app. They are configuration, not secrets. Copy to .env.local.

# The Google OAuth client id (FORAGE_GOOGLE_CLIENT_ID). Scopes are
# `openid email profile` only: the app reads and writes through the Forage API.
VITE_GOOGLE_CLIENT_ID=

# `true` lets `?demo=true` open the app signed in as the demo user. Leave unset
# for a real build: without it, `?demo=true` is ignored.
# VITE_DEMO_MODE=true

# Vite `base`. Defaults to `/`; #705 sets `/keel/forage/` for Pages.
# VITE_BASE_PATH=/
