# Secrets the Worker reads in local development. Copy to .dev.vars (gitignored)
# and fill in. In production each is set with `npx wrangler secret put NAME`.

# Client secret of the GitHub OAuth app (GitHub > Settings > Developer settings
# > OAuth Apps). The client ID is not secret and lives in wrangler.toml.
GITHUB_CLIENT_SECRET=

# The one GitHub numeric user ID allowed to sign in. Find yours with:
#   curl https://api.github.com/users/<your-login>   (the "id" field)
# Never the login name: logins can be renamed, IDs cannot.
ALLOWED_GITHUB_ID=

# Hive's Apps Script web-app URL (the /exec URL). Treated as a secret: the URL
# plus a key is full access to Hive.
HIVE_API_URL=

# Hive's MCP-only key: the MCP_API_KEY script property in Hive's Apps Script
# (hive#273), NOT its API_KEY. Revoke by clearing that property.
HIVE_API_KEY=
